{
  "domain": "atodosol_solarman",
  "name": "Atodosol Instalaciones Fotovoltaicas",
  "codeowners": [
    "@atodosol-maintainer"
  ],
  "config_flow": true,
  "dependencies": [
    "network",
    "dhcp"
  ],
  "dhcp": [
    {
      "macaddress": "E8FDF8*"
    },
    {
      "registered_devices": true
    }
  ],
  "documentation": "https://github.com/Atodosol/ha-solarman-atodosol",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/Atodosol/ha-solarman-atodosol/issues",
  "quality_scale": "custom",
  "requirements": [
    "propcache",
    "aiohttp",
    "aiofiles",
    "pyyaml"
  ],
  "version": "1.0.1"
}
